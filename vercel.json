{
  "version": 2,
  "builds": [
    { "src": "api/**/*.js", "use": "@vercel/node" },
    { "src": "*.html", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/debug-echo", "dest": "/api/debug-echo.js" },
    { "src": "/api/(.*)", "dest": "/api/app.js" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}
